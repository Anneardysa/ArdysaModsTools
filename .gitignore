# ArdysaModsTools — .gitignore
#
# How these rules work (read before editing):
#   - A pattern with no leading slash matches at ANY depth: `bin/` already covers
#     Tests/bin/, Installer/bin/, Frontend/dev/probe/bin/. Never repeat it per project.
#   - A negation (`!x`) CANNOT re-include a file whose parent directory is excluded.
#     That is why `!scripts/**/` exists below, before the per-file exceptions.
#   - Anchor a pattern with a slash (`build/Installer/Output/`) whenever a bare name
#     would match unrelated directories elsewhere in the tree.
#
# After editing, both checks must stay clean:
#   git ls-files -i -c --exclude-standard   -> must print nothing (tracked AND ignored
#                                              = a rule that lies about the repo)
#   git check-ignore -v <path>              -> names the exact rule hiding a file
#   git status --porcelain -uall            -> nothing that should be committed is missing

# ─── AI assistant workspaces ────────────────────────────────────────────────
.claude/
.agent/
.impeccable/

# ─── Build & publish output ─────────────────────────────────────────────────
bin/
obj/
publish/
portable/
dist/
delta/
protected/
installer_output/
build/Installer/Output/

# ─── Logs & diagnostics ─────────────────────────────────────────────────────
*.log
logs/
*.dmp
*.trx

# ─── Binaries ───────────────────────────────────────────────────────────────
*.exe
!tools/**/*.exe

# ─── IDE & editor ───────────────────────────────────────────────────────────
.vs/
.idea/
*.user
*.rsuser

# ─── OS-generated ───────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ─── Frontend/ (React sources ARE tracked; only tooling output is not — the
#     built HTML under Assets/Html is committed so the .NET build needs no Node)
node_modules/
Frontend/.vite/
Frontend/.vite-out/
.probe-shots/

# ─── Python helper scripts ──────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ─── Secrets & signed config ────────────────────────────────────────────────
.env
.env.*
*.secrets.json
config/feature_access.json

# ─── Local-only tooling (a few pipeline scripts are force-tracked below) ────
scripts/**
!scripts/**/
!scripts/**/*.iss
!scripts/release/generate-files-manifest.ps1
!scripts/release/publish-delta-to-r2.ps1
!scripts/release/publish-github.ps1
!scripts/release/open-mirror-issues.ps1
!scripts/dev/hooks/*
!scripts/dev/triage-selfcheck.mjs
commit-and-push.ps1
COMMIT_GUIDE.md

# ─── Local-only docs (kept out of both repos) ───────────────────────────────
docs/dev/DISTRIBUTION.md

# ─── AMT 3.0 (Rust + Tauri, ADR-0014) — not part of the 2.x branch ──────────
next/