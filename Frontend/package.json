{
   "name": "amt-frontend",
   "private": true,
   "type": "module",
   "description": "React source for the WebView2 pages in Assets/Html. Build output is committed; the .NET build never needs Node.",
   "scripts": {
      "build": "node build.mjs",
      "dev": "vite",
      "typecheck": "tsc --noEmit",
      "theme-audit": "node theme-audit.mjs"
   },
   "dependencies": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
   },
   "devDependencies": {
      "@types/node": "^26.2.0",
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1",
      "@vitejs/plugin-react": "^4.3.4",
      "typescript": "^5.7.2",
      "vite": "^6.0.7",
      "vite-plugin-singlefile": "^2.1.0"
   },
   "allowScripts": {
      "esbuild@0.25.12": true
   }
}
